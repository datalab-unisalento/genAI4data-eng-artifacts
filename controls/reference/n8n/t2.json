{
  "id": "bench_ref-t2",
  "name": "Benchmark workflow",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "benchmark_trigger",
      "name": "Benchmark Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://recorder:8090/source/usgs/earthquakes?run_id=ref-t2&attempt=0",
        "options": {}
      },
      "id": "source_1",
      "name": "Source 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const records = $('Source 1').first().json.features.map((f) => {\n  const mag = f.properties.mag;\n  const [lon, lat, depth] = f.geometry.coordinates;\n  return { id: f.id, magnitude: mag, place: f.properties.place, time_ms: f.properties.time,\n           longitude: lon, latitude: lat, depth_km: depth,\n           magnitude_band: mag < 4.0 ? 'minor' : (mag < 5.0 ? 'moderate' : 'major') };\n});\nreturn [{ json: { records } }];"
      },
      "id": "transform",
      "name": "Transform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://recorder:8090/sink/ref-t2?attempt=0",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "id": "sink",
      "name": "Sink",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        0
      ]
    }
  ],
  "connections": {
    "Benchmark Trigger": {
      "main": [
        [
          {
            "node": "Source 1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Source 1": {
      "main": [
        [
          {
            "node": "Transform",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transform": {
      "main": [
        [
          {
            "node": "Sink",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true
  }
}
