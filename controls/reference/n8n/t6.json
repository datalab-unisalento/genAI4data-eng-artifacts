{
  "id": "bench_ref-t6",
  "name": "Benchmark workflow",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "benchmark_trigger",
      "name": "Benchmark Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://recorder:8090/source/usgs/earthquakes?run_id=ref-t6&attempt=0",
        "options": {}
      },
      "id": "source_1",
      "name": "Source 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const bands = {};\nfor (const f of $('Source 1').first().json.features) {\n  const mag = f.properties.mag;\n  const depth = f.geometry.coordinates[2];\n  const name = mag < 4.0 ? 'minor' : (mag < 5.0 ? 'moderate' : 'major');\n  if (!bands[name]) bands[name] = { event_count: 0, max_magnitude: null, max_depth_km: null };\n  const b = bands[name];\n  b.event_count += 1;\n  b.max_magnitude = b.max_magnitude === null ? mag : Math.max(b.max_magnitude, mag);\n  b.max_depth_km = b.max_depth_km === null ? depth : Math.max(b.max_depth_km, depth);\n}\nconst records = ['minor', 'moderate', 'major'].filter((n) => bands[n]).map((n) => ({ magnitude_band: n, ...bands[n] }));\nreturn [{ json: { records } }];"
      },
      "id": "transform",
      "name": "Transform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://recorder:8090/sink/ref-t6?attempt=0",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "id": "sink",
      "name": "Sink",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        0
      ]
    }
  ],
  "connections": {
    "Benchmark Trigger": {
      "main": [
        [
          {
            "node": "Source 1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Source 1": {
      "main": [
        [
          {
            "node": "Transform",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transform": {
      "main": [
        [
          {
            "node": "Sink",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true
  }
}
