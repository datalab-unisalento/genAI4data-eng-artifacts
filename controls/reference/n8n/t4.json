        300,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const h = $('Source 1').first().json.hourly;\nconst days = {};\nh.time.forEach((t, i) => {\n  const d = t.slice(0, 10);\n  if (!days[d]) days[d] = { hours: 0, pm2_5_max: null, pm10_max: null };\n  days[d].hours += 1;\n  const p25 = h.pm2_5[i], p10 = h.pm10[i];\n  days[d].pm2_5_max = days[d].pm2_5_max === null ? p25 : Math.max(days[d].pm2_5_max, p25);\n  days[d].pm10_max = days[d].pm10_max === null ? p10 : Math.max(days[d].pm10_max, p10);\n});\nconst records = Object.keys(days).sort().map((d) => ({ date: d, ...days[d] }));\nreturn [{ json: { records } }];"
      },
      "id": "transform",
      "name": "Transform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ]
    },
    {
