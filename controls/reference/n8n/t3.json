{
  "id": "bench_ref-t3",
  "name": "Benchmark workflow",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "benchmark_trigger",
      "name": "Benchmark Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://recorder:8090/source/open-meteo/particulate?run_id=ref-t3&attempt=0",
        "options": {}
      },
      "id": "source_1",
      "name": "Source 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://recorder:8090/source/open-meteo/gases?run_id=ref-t3&attempt=0",
        "options": {}
      },
      "id": "source_2",
      "name": "Source 2",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        180
      ]
    },
    {
      "parameters": {
        "mode": "append",
        "numberInputs": 2
      },
      "id": "merge_sources",
      "name": "Merge Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        450,
        90
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $('Source 1').first().json.hourly;\nconst g = $('Source 2').first().json.hourly;\nconst gases = {};\ng.time.forEach((t, i) => { gases[t] = { no2: g.nitrogen_dioxide[i], o3: g.ozone[i] }; });\nconst records = [];\np.time.forEach((t, i) => {\n  if (Object.prototype.hasOwnProperty.call(gases, t)) {\n    records.push({ time: t, pm10: p.pm10[i], pm2_5: p.pm2_5[i],\n                   nitrogen_dioxide: gases[t].no2, ozone: gases[t].o3 });\n  }\n});\nreturn [{ json: { records } }];"
      },
      "id": "transform",
      "name": "Transform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://recorder:8090/sink/ref-t3?attempt=0",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "id": "sink",
      "name": "Sink",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        0
      ]
    }
  ],
  "connections": {
    "Benchmark Trigger": {
      "main": [
        [
          {
            "node": "Source 1",
            "type": "main",
            "index": 0
          },
          {
            "node": "Source 2",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Source 1": {
      "main": [
        [
          {
            "node": "Merge Sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Source 2": {
      "main": [
        [
          {
            "node": "Merge Sources",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge Sources": {
      "main": [
        [
          {
            "node": "Transform",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transform": {
      "main": [
        [
          {
            "node": "Sink",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true
  }
}
