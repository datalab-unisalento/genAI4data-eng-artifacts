    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const particulate = $('Source 1').first().json;\nconst gases = $('Source 2').first().json;\n\n// Convert hourly arrays to records\nconst particulateRecords = particulate.hourly.time.map((time, index) => ({\n  time,\n  pm10: particulate.hourly.pm10[index],\n  pm2_5: particulate.hourly.pm2_5[index]\n}));\n\nconst gasesRecords = gases.hourly.time.map((time, index) => {\n  return {\n    time,\n    nitrogen_dioxide: gases.hourly.nitrogen_dioxide[index],\n    ozone: gases.hourly.ozone[index]\n  };\n});\n\n// Create a map for fast lookup by time\nconst gasesMap = new Map();\nfor (const record of gasesRecords) {\n  gasesMap.set(record.time, record);\n}\n\n// Inner join on time\nconst joinedRecords = particulateRecords\n  .filter(partRecord => gasesMap.has(partRecord.time))\n  .map(partRecord => ({\n    ...partRecord,\n    ...gasesMap.get(partRecord.time)\n  }));\n\nreturn [{ json: { records: joinedRecords } }];"
      },
      "id": "transform",
      "name": "Transform",
      "type": "n8n-nodes-base.code",
