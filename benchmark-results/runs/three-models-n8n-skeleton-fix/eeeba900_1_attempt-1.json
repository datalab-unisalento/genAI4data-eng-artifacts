    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const source1 = $['Source 1'].first();\nconst source2 = $['Source 2'].first();\n\nif (!source1 || !source2) {\n  return [{ json: { records: [] } }];\n}\n\nconst data1 = source1.json;\nconst data2 = source2.json;\n\n// Extract hourly arrays from each source\nconst times1 = data1.hourly.time;\nconst pm10_1 = data1.hourly.pm10;\nconst pm25_1 = data1.hourly.pm2_5;\n\nconst times2 = data2.hourly.time;\nconst no2_2 = data2.hourly.nitrogen_dioxide;\nconst o3_2 = data2.hourly.ozone;\n\n// Build lookup maps from gas source (time -> values)\nconst gasMap = {};\nfor (let i = 0; i < times2.length; i++) {\n  gasMap[times2[i]] = {\n    nitrogen_dioxide: no2_2[i],\n    ozone: o3_2[i]\n  };\n}\n\n// Find matching times and build records\nconst matchedTimes = [];\nfor (let i = 0; i < times1.length; i++) {\n  const t = times1[i];\n  if (gasMap.hasOwnProperty(t)) {\n    matchedTimes.push(t);\n  }\n}\n\n// Build the records array with exact required fields\nconst records = matchedTimes.map(t => ({\n  time: t,\n  pm10: pm10_1[times1.indexOf(t)],\n  pm2_5: pm25_1[times1.indexOf(t)],\n  nitrogen_dioxide: gasMap[t].nitrogen_dioxide,\n  ozone: gasMap[t].ozone\n}));\n\nreturn [{ json: { records } }];"
      },
