    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sourceData = $('Source 1').first().json;\n\nconst recordsByDate = {};\nfor (let i = 0; i < sourceData.hourly.time.length; i++) {\n    const timeStr = sourceData.hourly.time[i];\n    const dateKey = timeStr.substring(0, 10);\n    if (!recordsByDate[dateKey]) {\n        recordsByDate[dateKey] = {\n            pm2_5_max: -Infinity,\n            pm10_max: -Infinity\n        };\n    }\n    recordsByDate[dateKey].pm2_5_max = Math.max(recordsByDate[dateKey].pm2_5_max, sourceData.hourly.pm2_5[i]);\n    recordsByDate[dateKey].pm10_max = Math.max(recordsByDate[dateKey].pm10_max, sourceData.hourly.pm10[i]);\n}\n\nconst records = Object.entries(recordsByDate).map(([date, data]) => ({\n    date,\n    hours: (sourceData.hourly.time.filter(timeStr => timeStr.startsWith(date))).length,\n    pm2_5_max: data.pm2_5_max,\n    pm10_max: data.pm10_max\n}));\n\nreturn [{ json: { records } }];"
      },
