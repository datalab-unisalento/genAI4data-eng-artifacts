    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const particulate = $('Source 1').first().json;\nconst gases = $('Source 2').first().json;\n\nconst particulateRecords = particulate.hourly.time.map((time, index) => ({\n  time,\n  pm10: particulate.hourly.pm10[index],\n  pm2_5: particulate.hourly.pm2_5[index]\n}));\n\nconst gasesRecords = gases.hourly.time.map((time, index) => ({\n  time,\n  nitrogen_dioxide: gases.hourly.nitrogen_dioxide[index],\n  ozone: gases.hourly.ozone[index]\n}));\n\nconst joinedRecords = particulateRecords.flatMap(particulateRecord => {\n  const matchingGasesRecord = gasesRecords.find(gasRecord => gasRecord.time === particulateRecord.time);\n  if (matchingGasesRecord) {\n    return [{\n      ...particulateRecord,\n      ...matchingGasesRecord\n    }];\n  }\n  return [];\n});\n\nreturn [{ json: { records: joinedRecords } }];"
      },
