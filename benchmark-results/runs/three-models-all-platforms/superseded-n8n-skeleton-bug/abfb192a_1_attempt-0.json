        "mode": "runOnceForAllItems",
        "jsCode": "const data = $('Source 1').first().json;\nconst times = data.hourly.time;\nconst pm2_5_values = data.hourly.pm2_5;\n\nconst records = [];\nfor (let i = 2; i < times.length; i++) {\n  const current_pm2_5 = pm2_5_values[i];\n  const prev1_pm2_5 = pm2_5_values[i - 1];\n  const prev2_pm2_5 = pm2_5_values[i - 2];\n\n  const peak = Math.max(current_pm2_5, prev1_pm2_5, prev2_pm2_5);\n\n  records.push({\n    time: times[i],\n    pm2_5: current_pm2_5,\n    pm2_5_peak_3h: peak\n  });\n}\n\nreturn [{ json: { records } }];"
      },
