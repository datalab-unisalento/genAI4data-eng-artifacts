      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sourceData = $('Source 1').first().json;\n\nconst recordsByDate = {};\n\nfor (let i = 0; i < sourceData.hourly.time.length; i++) {\n    const timeStr = sourceData.hourly.time[i];\n    const dateKey = timeStr.substring(0, 10);\n    const pm2_5Value = sourceData.hourly.pm2_5[i];\n    const pm10Value = sourceData.hourly.pm10[i];\n\n    if (!recordsByDate[dateKey]) {\n        recordsByDate[dateKey] = {\n            date: dateKey,\n            hours: 0,\n            pm2_5_max: -Infinity,\n            pm10_max: -Infinity\n        };\n    }\n\n    const record = recordsByDate[dateKey];\n    record.hours++;\n    record.pm2_5_max = Math.max(record.pm2_5_max, pm2_5Value);\n    record.pm10_max = Math.max(record.pm10_max, pm10Value);\n}\n\nconst records = Object.values(recordsByDate);\nreturn [{ json: { records } }];"
      },
