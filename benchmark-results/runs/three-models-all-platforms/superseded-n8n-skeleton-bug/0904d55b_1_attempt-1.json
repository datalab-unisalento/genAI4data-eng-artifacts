      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const response = $json;\nconst features = response.features || [];\n\nconst records = features.map(feature => {\n  const props = feature.properties;\n  const coords = feature.geometry.coordinates;\n  const magnitude = typeof props.mag === 'number' ? props.mag : 0;\n  \n  let magnitudeBand;\n  if (magnitude < 4.0) {\n    magnitudeBand = 'minor';\n  } else if (magnitude >= 5.0) {\n    magnitudeBand = 'major';\n  } else {\n    magnitudeBand = 'moderate';\n  }\n  \n  return {\n    id: String(feature.id),\n    magnitude: magnitude,\n    place: props.place || '',\n    time_ms: typeof props.time === 'number' ? props.time : 0,\n    longitude: coords[0],\n    latitude: coords[1],\n    depth_km: coords.length > 2 ? coords[2] : 0,\n    magnitude_band: magnitudeBand\n  };\n});\n\nreturn [{ json: { records } }];"
      },
