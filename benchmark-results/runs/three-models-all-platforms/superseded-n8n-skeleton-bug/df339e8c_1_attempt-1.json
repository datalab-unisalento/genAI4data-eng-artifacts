    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const features = $json.features || [];\nconst bands = { minor: [], moderate: [], major: [] };\nfor (const f of features) {\n  const mag = f.properties.mag;\n  const depth = f.geometry.coordinates[2];\n  let band; if (mag < 4.0) band = 'minor';\n  else if (mag < 5.0) band = 'moderate';\n  else band = 'major';\n  bands[band].push({ mag, depth });\n}\nconst result = [];\nfor (const [name, evts] of Object.entries(bands)) {\n  if (evts.length === 0) continue;\n  const magnitudes = evts.map(e => e.mag);\n  result.push({\n    magnitude_band: name,\n    event_count: evts.length,\n    max_magnitude: Math.max(...magnitudes),\n    max_depth_km: Math.max(...evts.map(e => e.depth))\n  });\n}\nreturn [{ json: { records: result } }];"
      },
