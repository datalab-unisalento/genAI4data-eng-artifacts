        "jsCode": "const data = $json;\nif (!data || !data.hourly) return [];\nconst times = data.hourly.time; const pm25 = data.hourly.pm2_5; const pm10 = data.hourly.pm10;\nconst dateMap = {};\nfor (let i = 0; i < times.length; i++) {\n  const dateStr = times[i].substring(0, 10);\n  if (!dateMap[dateStr]) { dateMap[dateStr] = []; }\n  dateMap[dateStr].push({ pm2_5: pm25[i], pm10: pm10[i] });\n}\nconst result = Object.entries(dateMap).map(([date, records]) => ({\n  date,\n  hours: records.length,\n  pm2_5_max: Math.max(...records.map(r => r.pm2_5)),\n  pm10_max: Math.max(...records.map(r => r.pm10))\n}));\nreturn [{ json: { records: result } }];",
