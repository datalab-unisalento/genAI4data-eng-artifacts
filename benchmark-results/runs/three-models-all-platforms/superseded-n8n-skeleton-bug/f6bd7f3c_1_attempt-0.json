        "mode": "runOnceForAllItems",
        "jsCode": "const sourceData = $('Source 1').first().json;\nconst times = sourceData.hourly.time;\nconst pm2_5s = sourceData.hourly.pm2_5;\n\nconst records = [];\nfor (let i = 2; i < times.length; i++) {\n    const currentPm2_5 = pm2_5s[i];\n    const previousTwoHours = [pm2_5s[i-1], pm2_5s[i-2]];\n    const maxPeak3h = Math.max(currentPm2_5, ...previousTwoHours);\n\n    records.push({\n        time: times[i],\n        pm2_5: currentPm2_5,\n        pm2_5_peak_3h: maxPeak3h\n    });\n}\nreturn [{ json: { records } }];"
      },
