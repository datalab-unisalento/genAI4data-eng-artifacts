      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const particulate = $('Source 1').first().json;\nconst gases = $('Source 2').first().json;\n\n// Convert hourly arrays to records\nconst particulateRecords = particulate.hourly.time.map((time, i) => ({\n  time,\n  pm10: particulate.hourly.pm10[i],\n  pm2_5: particulate.hourly.pm2_5[i]\n}));\n\nconst gasesRecords = gases.hourly.time.map((time, i) => {\n  return {\n    time,\n    nitrogen_dioxide: gases.hourly.nitrogen_dioxide[i],\n    ozone: gases.hourly.ozone[i]\n  };\n});\n\n// Create a map for gas records by time\nconst gasMap = new Map();\nfor (const record of gasesRecords) {\n  gasMap.set(record.time, record);\n}\n\n// Inner join on time\nconst joinedRecords = [];\nfor (const record of particulateRecords) {\n  const gasRecord = gasMap.get(record.time);\n  if (gasRecord) {\n    joinedRecords.push({\n      ...record,\n      ...gasRecord\n    });\n  }\n}\n\nreturn [{ json: { records: joinedRecords } }];"
      },
