    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const data = $json;\nconst features = data.features || [];\n\nconst bands = { minor: [], moderate: [], major: [] };\n\nfeatures.forEach(f => {\n  const mag = f.properties.mag;\n  const depth = f.geometry.coordinates[2];\n  let band; \n  if (mag < 4.0) band = 'minor';\n  else if (mag < 5.0) band = 'moderate';\n  else band = 'major';\n  bands[band].push({ mag, depth });\n});\n\nconst result = [];\nfor (const [name, events] of Object.entries(bands)) {\n  if (events.length === 0) continue;\n  const magnitudes = events.map(e => e.mag);\n  result.push({\n    magnitude_band: name,\n    event_count: events.length,\n    max_magnitude: Math.max(...magnitudes),\n    max_depth_km: Math.max(...events.map(e => e.depth))\n  });\n}\n\nreturn [{ json: { records: result } }];"
      },
