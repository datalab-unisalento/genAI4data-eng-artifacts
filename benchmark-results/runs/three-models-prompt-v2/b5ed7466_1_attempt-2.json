    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const data = $json;\nif (!data || !Array.isArray(data.hourly.time)) {\n  return [{ json: { records: [] } }];\n}\n\nconst times = data.hourly.time;\nconst pm25 = data.hourly.pm2_5;\nconst pm10 = data.hourly.pm10;\n\n// Group by date (first 10 chars of time string)\nconst groups = {};\nfor (let i = 0; i < times.length; i++) {\n  const date = times[i].substring(0, 10);\n  if (!groups[date]) {\n    groups[date] = [];\n  }\n  groups[date].push({\n    pm2_5: pm25[i],\n    pm10: pm10[i]\n  });\n}\n\n// Build summary records\nconst results = [];\nfor (const date in groups) {\n  const entries = groups[date];\n  const pm25Vals = entries.map(e => e.pm2_5);\n  const pm10Vals = entries.map(e => e.pm10);\n  results.push({\n    date,\n    hours: entries.length,\n    pm2_5_max: Math.max(...pm25Vals),\n    pm10_max: Math.max(...pm10Vals)\n  });\n}\n\nreturn [{ json: { records: results } }];"
      },
