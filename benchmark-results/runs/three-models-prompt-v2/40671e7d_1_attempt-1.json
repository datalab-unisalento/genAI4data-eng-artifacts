      "parameters": {
        "method": "GET",
        "url": "http://recorder:8090/source/open-meteo/gases?run_id=40671e7d_1&attempt=1",
        "options": {}
      },
      "id": "source_2",
      "name": "Source 2",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 180]
    },
    {
      "parameters": {
        "mode": "append",
        "numberInputs": 2
      },
      "id": "merge_sources",
      "name": "Merge Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [450, 90]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const particulate = $('Source 1').first().json;\nconst gases = $('Source 2').first().json;\n\n// Convert hourly arrays to records for both sources\nconst particulateRecords = particulate.hourly.time.map((time, index) => ({\n  time,\n  pm10: particulate.hourly.pm10[index],\n  pm2_5: particulate.hourly.pm2_5[index]\n}));\n\nconst gasRecords = gases.hourly.time.map((time, index) => ({\n  time,\n  nitrogen_dioxide: gases.hourly.nitrogen_dioxide[index],\n  ozone: gases.hourly.ozone[index]\n}));\n\n// Create a Map for quick lookup of gas records by time\nconst gasMap = new Map(gasRecords.map(record => [record.time, record]));\n\n// Inner join on exact time values\nconst joinedRecords = particulateRecords.filter(particulateRecord => {\n  const gasRecord = gasMap.get(particulateRecord.time);\n  if (gasRecord) {\n    return {\n      ...particulateRecord,\n      ...gasRecord\n    };\n  }\n});\n\nreturn [{ json: { records: joinedRecords } }];"
      },
      "id": "transform",
      "name": "Transform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://recorder:8090/sink/40671e7d_1?attempt=1",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{{ $json }}",
        "options": {}
      },
      "id": "sink",
      "name": "Sink",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 0]
    }
