    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const source1 = $['Source 1'].first();\nconst source2 = $['Source 2'].first();\n\nif (!source1 || !source2) {\n  return [{ json: { records: [] } }];\n}\n\nconst data1 = source1.json;\nconst data2 = source2.json;\n\n// Extract hourly arrays from both responses\nconst times1 = data1.hourly.time;\nconst pm10_1 = data1.hourly.pm10;\nconst pm25_1 = data1.hourly.pm2_5;\n\nconst times2 = data2.hourly.time;\nconst no2_2 = data2.hourly.nitrogen_dioxide;\nconst o3_2 = data2.hourly.ozone;\n\n// Build lookup maps from gas data by time\nconst gasMap = {};\nfor (let i = 0; i < times2.length; i++) {\n  gasMap[times2[i]] = {\n    nitrogen_dioxide: no2_2[i],\n    ozone: o3_2[i]\n  };\n}\n\n// Inner join: keep only times present in both datasets\nconst records = [];\nfor (let i = 0; i < times1.length; i++) {\n  const time = times1[i];\n  if (gasMap.hasOwnProperty(time)) {\n    records.push({\n      time: time,\n      pm10: pm10_1[i],\n      pm2_5: pm25_1[i],\n      nitrogen_dioxide: gasMap[time].nitrogen_dioxide,\n      ozone: gasMap[time].ozone\n    });\n  }\n}\n\nreturn [{ json: { records } }];"
      },
