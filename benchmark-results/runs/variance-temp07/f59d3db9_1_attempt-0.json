    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Extract records from GeoJSON\nconst records = [];\nconst geojson = $('Source 1').first().json;\n\nfor (let i = 0; i < geojson.features.length; i++) {\n  const feature = geojson.features[i];\n  \n  // Determine magnitude_band\n  let magnitudeBand;\n  if (feature.properties.mag < 4.0) {\n    magnitudeBand = 'minor';\n  } else if (feature.properties.mag >= 5.0) {\n    magnitudeBand = 'major';\n  } else {\n    magnitudeBand = 'moderate';\n  }\n  \n  records.push({\n    id: feature.id,\n    magnitude: feature.properties.mag,\n    place: feature.properties.place,\n    time_ms: feature.properties.time,\n    longitude: feature.geometry.coordinates[0],\n    latitude: feature.geometry.coordinates[1],\n    depth_km: feature.geometry.coordinates[2],\n    magnitude_band: magnitudeBand\n  });\n}\n\nreturn [{ json: { records } }];"
      },
