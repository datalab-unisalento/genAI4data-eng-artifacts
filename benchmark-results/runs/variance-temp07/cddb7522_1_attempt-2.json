    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const records = [];\n\n// Extract features from the GeoJSON response\nconst features = $('Source 1').first().json.features;\n\n// Process each feature to create a flattened record\nfeatures.forEach(feature => {\n  const { id, mag, place, time } = feature.properties;\n  const [longitude, latitude, depth_km] = feature.geometry.coordinates;\n  \n  // Determine magnitude band\n  let magnitude_band;\n  if (mag < 4.0) {\n    magnitude_band = 'minor';\n  } else if (mag >= 4.0 && mag < 5.0) {\n    magnitude_band = 'moderate';\n  } else {\n    magnitude_band = 'major';\n  }\n  \n  records.push({\n    id,\n    magnitude: mag,\n    place,\n    time_ms: time,\n    longitude,\n    latitude,\n    depth_km,\n    magnitude_band\n  });\n});\n\nreturn [{ json: { records } }];"
      },
      "id": "transform",
      "name": "Transform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
