        "jsCode": "const data = $('Source 1').first().json;\nconst times = data.hourly.time;\nconst pm2_5s = data.hourly.pm2_5;\n\nconst records = [];\nfor (let i = 2; i < times.length; i++) {\n  const currentPm25 = pm2_5s[i];\n  const prev1Pm25 = pm2_5s[i - 1];\n  const prev2Pm25 = pm2_5s[i - 2];\n  \n  const peak3h = Math.max(currentPm25, prev1Pm25, prev2Pm25);\n  \n  records.push({\n    time: times[i],\n    pm2_5: currentPm25,\n    pm2_5_peak_3h: peak3h\n  });\n}\n\nreturn [{ json: { records } }];"
      },
